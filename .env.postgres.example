# Example .env for the Postgres backend.
#
# Switch to Postgres by:
#   1) cp .env.postgres.example .env.postgres
#   2) docker compose -f docker-compose.postgres.yml up -d
#   3) Edit prisma/schema.prisma:  provider = "postgresql"
#   4) Re-baseline:  rm -rf prisma/migrations && \
#                    DATABASE_URL=... npx prisma migrate dev --name init_postgres
#   5) (Optional) Import data from SQLite:
#                    npm run db:export-json   # dumps prisma/dev.db → tmp/export
#                    DATABASE_URL=... npm run db:import-json
#   6) Run the app with the new env file:
#                    cp .env.postgres .env  (or use a process manager / Vercel)
#
# Detailed steps in README.md → "從 SQLite 平移到 PostgreSQL".

DATABASE_URL="postgresql://together:together@localhost:5432/together?schema=public"

# Inherited from the SQLite env — keep these the same when switching providers.
SESSION_SECRET="please-rotate-32-bytes-min"
# RESEND_API_KEY=
# MAIL_FROM=
# APP_URL=
# TRUST_PROXY=true
