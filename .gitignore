node_modules/
.next/
out/
.DS_Store
*.log
.env
.env*.local
next-env.d.ts
screenshots/
shoot*.mjs

# SQLite dev DB (recreate with `npm run db:push && npm run db:seed`)
prisma/dev.db
prisma/dev.db-journal

# TS incremental build cache
tsconfig.tsbuildinfo

# Uploaded user images (runtime; keep dir, ignore contents)
public/uploads/*

# JSON dumps from scripts/db-export-json.ts (runtime artefact, not source)
tmp/
.env.postgres
!public/uploads/.gitkeep

# Local backups of previous versions (e.g. ./old). These must NEVER be
# part of the build: tsconfig's "**/*.ts(x)" glob + the "@/*" → "./*" path
# alias would otherwise pull a whole second copy of the app into the
# compile, and Next.js could try to treat its routes as real pages —
# producing the "works in a clean build but the deployed frontend is dead"
# failure. Keep your backup, just don't ship or compile it.
/old/
/old-*/
/*-old/
/backup/
/backups/
