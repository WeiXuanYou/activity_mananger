# ── Database ──────────────────────────────────────────────────────
# DEV: a file inside the repo is fine.
DATABASE_URL="file:./dev.db"
#
# ⚠️ PRODUCTION: do NOT leave this as ./dev.db. A repo-relative file
# lives inside the (ephemeral) container and gets WIPED on every
# redeploy — that's the #1 cause of "my data resets when I update".
# Point it at persistent storage instead:
#   • SQLite on a mounted disk:  DATABASE_URL="file:/data/together.db"
#   • Managed Postgres:          DATABASE_URL="postgresql://user:pw@host:5432/together"
# See README → "資料持久化" for the full explanation.

# Generate a fresh 32-byte secret in prod (e.g. `openssl rand -hex 32`)
SESSION_SECRET="please-rotate-32-bytes-min"

# ── Session cookie security ───────────────────────────────────────
# Controls the `Secure` flag on the login cookie. By default the app
# auto-detects: it sends a Secure cookie ONLY when the request actually
# arrives over HTTPS (via the reverse proxy's x-forwarded-proto header),
# and a normal cookie otherwise.
#
# Why this matters: a Secure cookie is dropped by the browser over plain
# HTTP, which makes the app demand a fresh login on EVERY click. So if you
# self-host over HTTP (an IP or a domain without TLS), leave this unset or
# set it to "false" and logins will stick.
#
#   COOKIE_SECURE=true   → force Secure (set this once you're on real HTTPS)
#   COOKIE_SECURE=false  → never Secure (plain-HTTP deployments)
#   (unset)              → auto-detect from x-forwarded-proto  ← recommended
# COOKIE_SECURE=false

# Phase G — AI assistant. Leave unset to run the assistant in stub mode
# (local heuristics). Set it to switch /app/assistant to real Claude
# (Opus 4.8) with zero code changes.
# ANTHROPIC_API_KEY="sk-ant-..."

# --- Web Push notifications (optional) ---
# Generate a key pair with:  npm run gen-vapid
# Then paste the three values below. Push is DISABLED until these are set
# (the in-app bell still works regardless).
#   VAPID_PUBLIC_KEY            — server-side public key
#   VAPID_PRIVATE_KEY          — KEEP SECRET; anyone with it can push as you
#   NEXT_PUBLIC_VAPID_PUBLIC_KEY — same as VAPID_PUBLIC_KEY, exposed to the browser
#   VAPID_SUBJECT              — a mailto: or https: contact URL
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- 公開網址（強烈建議設定）---
# 你的網站對外的完整網址。設了之後：
#   • Email 驗證信 / 忘記密碼信裡的連結會指向正確網址（不設的話可能變成
#     內部主機名或 localhost，使用者點了到不了 → 「email 認證有問題」）
# APP_URL=https://together.example.com

# --- Email 寄送（要寄真信就必須設）---
# 沒設 RESEND_API_KEY 時，驗證信 / 重設密碼信「只會印在伺服器 log」不會真的寄出。
# 去 https://resend.com 申請一組 API key（免費額度對家庭/朋友規模綽綽有餘）。
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=相聚 Together <noreply@your-verified-domain.com>

# --- 上傳圖片存放位置（正式環境建議設定）---
# 預設存到 <專案>/public/uploads。容器/Serverless 上這個資料夾常是唯讀或
# 重新部署就清空 → 圖片會壞掉/消失。設成掛載的持久磁碟路徑就能解決：
# UPLOADS_DIR=/data/uploads
