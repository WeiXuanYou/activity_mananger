// 相聚 Together — full data schema for Phase B+.
// Provider: SQLite for dev (file-based, no infra). Swap to PostgreSQL in prod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================================
// Identity & Sessions
// =====================================================================

model User {
  id          String    @id @default(cuid())
  handle      String    @unique
  name        String
  bio         String?
  avatarColor String
  initial     String
  /// Optional uploaded avatar (data URL, base64). When set, UI shows the
  /// image instead of the initial+color circle. Kept inline in the row
  /// so a family/friends scale install doesn't need separate blob storage;
  /// the action layer caps incoming size (~500 KB) before write.
  avatarImage String?
  /// Contact email — optional in the DB but required at setup completion
  /// (the requirement is enforced in `completeSetupAction`, not the
  /// schema, because the row exists before the user has picked an
  /// email — invite redemption and the bootstrap admin both create the
  /// row first). Drives the password-reset and handle-recovery flows.
  email       String?   @unique
  /// When the user clicked the verification link sent to `email`.
  /// Null = unverified (just set their email, but we haven't confirmed
  /// they own the address). The recovery flow currently sends to both
  /// verified and unverified addresses for backward compatibility; a
  /// later release may require verification for password reset once
  /// existing users have had time to verify.
  emailVerifiedAt DateTime?
  /// When we last emailed this user their handle (for the "I forgot my
  /// handle" flow). Used to enforce the same 60-second cooldown as
  /// password resets, but kept on User instead of in a separate table
  /// because handle recovery doesn't issue a token — there's nothing
  /// to revoke, just a "wait a minute" guard against mail-bombing.
  lastHandleRecoveryAt DateTime?
  /// Birthday. Year is significant for the age-display widget on
  /// profiles; the cron only matches month-day. Optional — users can
  /// leave it blank.
  birthday    DateTime?
  /// Has the user completed the post-signup profile form (name, handle,
  /// avatar)? Existing seeded users default to true. New users created
  /// by `redeemInvite` start at false and are routed to /app/setup.
  setupCompleted Boolean @default(true)
  /// Hashed password (scrypt) for handle+password login. Optional —
  /// users may be created via invite codes only, in which case they
  /// have a session cookie but no password until they set one in
  /// /app/setup (recommended) or skip it (still works, just no
  /// way to log back in on a new device).
  passwordHash String?
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id])
  createdAt   DateTime  @default(now())

  sessions          Session[]
  invitesCreated    InviteCode[]          @relation("InviteCreator")
  inviteRedeemed    InviteCode?           @relation("InviteRedeemer")
  posts             Post[]                @relation("PostAuthor")
  postsPinned       Post[]                @relation("PostPinner")
  activities        Activity[]
  pollsCreated      Poll[]                @relation("PollAuthor")
  votes             PollVote[]
  rsvps             ActivityParticipant[]
  comments          Comment[]
  reactions         Reaction[]
  customPages       CustomPage[]
  requestsMade      PermissionRequest[]   @relation("RequestUser")
  requestsDecided   PermissionRequest[]   @relation("RequestDecider")
  categoriesCreated Category[]
  notifications     Notification[]
  expensesPaid      Expense[]             @relation("ExpensePayer")
  permissionGrants    UserPermissionGrant[] @relation("PermissionGrantee")
  permissionsGranted  UserPermissionGrant[] @relation("PermissionGranter")
  lodgings          Lodging[]             @relation("LodgingAddedBy")
  passwordResets    PasswordReset[]
  emailVerifications EmailVerification[]
  feedback          Feedback[]            @relation("FeedbackAuthor")
  feedbackHandled   Feedback[]            @relation("FeedbackHandler")
  pushSubscriptions PushSubscription[]
  albumPhotos       AlbumPhoto[]          @relation("AlbumPhotoUploader")

  @@index([roleId])
}

/// Per-user extra permissions on top of what their role gives them.
/// Used by admins to delegate specific abilities — currently the only
/// useful one is `invite.create` (let trusted Members generate codes
/// without bumping them to full Editor). The table is intentionally
/// generic so we can grant other keys later without schema change.
model UserPermissionGrant {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("PermissionGrantee", fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String
  grantedById   String?
  grantedBy     User?    @relation("PermissionGranter", fields: [grantedById], references: [id])
  grantedAt     DateTime @default(now())

  @@unique([userId, permissionKey])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model InviteCode {
  id            String    @id @default(cuid())
  code          String    @unique
  createdById   String
  createdBy     User      @relation("InviteCreator", fields: [createdById], references: [id])
  usedById      String?   @unique
  usedBy        User?     @relation("InviteRedeemer", fields: [usedById], references: [id])
  defaultRoleId String
  defaultRole   Role      @relation(fields: [defaultRoleId], references: [id])
  /// If true (demo seed only): the code re-logs-in as the original
  /// redeemer instead of failing. Production invites default false
  /// — one-shot like a real referral.
  reusable      Boolean   @default(false)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdById])
}

// =====================================================================
// Roles & Permissions
// =====================================================================

model Role {
  id          String  @id @default(cuid())
  name        String  @unique // Guest | Member | Editor | Admin
  description String?
  isSystem    Boolean @default(true)

  users           User[]
  invitesDefault  InviteCode[]
  permissions     RolePermission[]
  requestsTarget  PermissionRequest[] @relation("RequestTarget")
  requestsCurrent PermissionRequest[] @relation("RequestCurrent")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // post.create, activity.create, admin.approve, ...
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PermissionRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("RequestUser", fields: [userId], references: [id])
  currentRoleId   String
  currentRole     Role      @relation("RequestCurrent", fields: [currentRoleId], references: [id])
  requestedRoleId String
  requestedRole   Role      @relation("RequestTarget", fields: [requestedRoleId], references: [id])
  reason          String
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById     String?
  decidedBy       User?     @relation("RequestDecider", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

// =====================================================================
// Categories
// =====================================================================

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  emoji       String
  /// Optional uploaded icon image (URL). When set, the UI shows this
  /// image instead of the `emoji`. Lets creators use a custom picture
  /// as the category icon. NULL = fall back to emoji (original behaviour).
  iconImage   String?
  color       String // see modules/core/categories/types.ts
  isDefault   Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  description String?
  createdAt   DateTime @default(now())

  activities  ActivityCategory[]
  posts       PostCategory[]
  polls       PollCategory[]
  customPages CustomPageCategory[]
}

// =====================================================================
// Activities, RSVPs
// =====================================================================

model Activity {
  id          String    @id @default(cuid())
  title       String
  description String
  location    String
  cover       String // CSS gradient or image URL
  startsAt    DateTime
  endsAt      DateTime?
  visibility  String    @default("PUBLIC") // PUBLIC | MEMBERS
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  pollId      String?   @unique
  poll        Poll?     @relation(fields: [pollId], references: [id])
  /// Manually hidden by the owner or a moderator. NOT null = hidden.
  /// Query helpers filter these out by default; the detail page still
  /// renders the activity for someone who has the direct link, but
  /// surfaces a "已隱藏" banner.
  hiddenAt    DateTime?
  createdAt   DateTime  @default(now())

  participants ActivityParticipant[]
  categories   ActivityCategory[]
  expenses     Expense[]
  reminders    ActivityReminder[]
  lodgings     Lodging[]              @relation("LodgingActivity")

  @@index([startsAt])
  @@index([authorId])
}

/// One row per (activity, tier) pair when a reminder has been sent.
/// Existence = "this tier already fired" — the cron worker checks for
/// the absence of a row before sending, so it's safe to run frequently.
///
/// Tiers (text so we can add more without a migration):
///   - "DAY_BEFORE" — fired ~24h before startsAt
///   - "HOUR_BEFORE" — fired ~2h before startsAt
model ActivityReminder {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tier       String
  sentAt     DateTime @default(now())
  /// How many notifications we created in this batch — useful for the
  /// admin "last run" view.
  notifiedUserCount Int @default(0)

  @@unique([activityId, tier])
  @@index([activityId])
}

/// One spent line per activity. v1: equal-split across all GOING+MAYBE
/// participants computed in the app layer — no per-person allocation
/// table yet. Move to ExpenseSplit when we need uneven splits.
model Expense {
  id          String   @id @default(cuid())
  activityId  String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  payerId     String
  payer       User     @relation("ExpensePayer", fields: [payerId], references: [id])
  description String
  /// Amount in 1/100 of currency unit (cents). NT$1,500 = 150000.
  amountCents Int
  /// Free-text: "TWD", "JPY" etc. Default TWD for the family demo.
  currency    String   @default("TWD")
  createdAt   DateTime @default(now())

  @@index([activityId])
  @@index([payerId])
}

model ActivityParticipant {
  activityId  String
  userId      String
  status      String // GOING | MAYBE | DECLINED
  respondedAt DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([activityId, userId])
}

model ActivityCategory {
  activityId String
  categoryId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([activityId, categoryId])
}

// =====================================================================
// Polls
// =====================================================================

model Poll {
  id             String    @id @default(cuid())
  question       String
  authorId       String
  author         User      @relation("PollAuthor", fields: [authorId], references: [id])
  /// "STANDARD" (default — text options) | "SCHEDULE" (Doodle-style: each
  /// option is an ISO datetime string; UI renders dates and the top-voted
  /// option is highlighted as the suggested time)
  kind           String    @default("STANDARD")
  multiSelect    Boolean   @default(false)
  anonymous      Boolean   @default(false)
  allowAddOption Boolean   @default(true)
  closesAt       DateTime?
  /// Manually hidden by the owner or a moderator. See Activity.hiddenAt
  /// for the same pattern.
  hiddenAt       DateTime?
  createdAt      DateTime  @default(now())

  options    PollOption[]
  activity   Activity?
  categories PollCategory[]
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String
  order     Int        @default(0)
  addedById String?
  votes     PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String     @id @default(cuid())
  optionId  String
  userId    String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([optionId, userId])
}

model PollCategory {
  pollId     String
  categoryId String
  poll       Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([pollId, categoryId])
}

// =====================================================================
// Posts, Comments, Reactions
// =====================================================================

model Post {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation("PostAuthor", fields: [authorId], references: [id])
  kind       String // ARTICLE | RECOMMENDATION | NOTE
  title      String?
  body       String
  visibility String   @default("PUBLIC")
  isPinned   Boolean  @default(false)
  pinnedById String?
  pinnedBy   User?    @relation("PostPinner", fields: [pinnedById], references: [id])
  /// Manually hidden by the owner or a moderator. See Activity.hiddenAt.
  hiddenAt   DateTime?
  /// Optional "bonus" / reward attached to the post.
  /// `bonus` is the human-readable description; the structured fields
  /// (`bonusKind`, `bonusLimit`) are presentation hints so the card can
  /// render an emoji + headline without parsing prose. All three are
  /// optional individually — minimum to "have a bonus" is `bonus`
  /// non-null. Authors opt in via a toggle on the create form.
  bonus      String?
  /// Coarse category — MEAL / DRINK / MONEY / TASK / OTHER. Used by
  /// PostCard to pick the headline emoji and label. NULL keeps the
  /// generic 🎁 fallback for legacy bonuses or "I don't want to pick".
  bonusKind  String?
  /// How many people the bonus is offered to (e.g. "前 3 名"). NULL =
  /// unlimited / not specified.
  bonusLimit Int?
  /// JSON-encoded array of attached images: `[{ url, thumbUrl }]`.
  /// NULL / "[]" = no images. Stored inline as a string for SQLite
  /// (swap to a Json column on Postgres). The action layer caps the
  /// count + relies on the upload pipeline for per-file size limits.
  images     String?
  /// When true, ANY signed-in member can edit this post (not just the
  /// author / moderators). Delete + hide stay owner-or-moderator only.
  /// Opt-in per post by the author. Default false = original behaviour.
  allowCollab Boolean @default(false)
  createdAt  DateTime @default(now())

  categories PostCategory[]

  @@index([authorId])
  @@index([isPinned])
}

model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model Comment {
  id              String    @id @default(cuid())
  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  parentType      String // POST | ACTIVITY | PAGE | COMMENT
  parentId        String
  body            String
  /// Optional single attached image (url). NULL = text-only comment.
  /// Comments stay lightweight — one image, no gallery. Uses the same
  /// upload pipeline as posts; only the URL is stored here.
  image           String?
  // Self-relation for threading. parentCommentId points at another Comment;
  // `replies` is the back-reference. Empty for top-level comments.
  parentCommentId String?
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         Comment[] @relation("CommentReplies")
  createdAt       DateTime  @default(now())

  @@index([parentType, parentId])
  @@index([parentCommentId])
}

model Reaction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  parentType String // POST | ACTIVITY | COMMENT | PAGE
  parentId   String
  kind       String   @default("LIKE") // LIKE | HEART | LAUGH | ...
  createdAt  DateTime @default(now())

  @@unique([userId, parentType, parentId, kind])
  @@index([parentType, parentId])
}

// =====================================================================
// Custom Pages (CMS)
// =====================================================================

model CustomPage {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  cover       String
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  visibility  String    @default("PUBLIC")
  /// When true, ANY signed-in member can edit this page's blocks (not
  /// just the owner / page.publish holders). Delete stays owner-or-admin.
  /// Opt-in per page by the owner. Default false = original behaviour.
  allowCollab Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  blocks     CustomPageBlock[]
  categories CustomPageCategory[]
}

model CustomPageBlock {
  id        String     @id @default(cuid())
  pageId    String
  page      CustomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String // richtext | markdown | html | image | embed-poll
  data      String // JSON-encoded; Phase A SQLite, swap to Json column on Postgres
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([pageId, order])
}

model CustomPageCategory {
  pageId     String
  categoryId String
  page       CustomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([pageId, categoryId])
}

// =====================================================================
// Notifications (in-app only — no DMs, per product requirement)
// =====================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String // recipient
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // permission.approved | permission.rejected | activity.rsvp | post.pinned | ...
  title     String
  body      String
  link      String? // in-app path to open when clicked
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// =====================================================================
// PushSubscription — Web Push (PWA) subscriptions, one row per browser/
// device a user has granted notification permission on. The `endpoint` is
// the unique push-service URL; `p256dh` + `auth` are the client's public
// keys used to encrypt the payload. We fan out to every row for a user
// when an in-app notification is created, so the same events that fill the
// bell also reach the phone's lock screen.
// =====================================================================
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// User-agent at subscribe time — lets the account page show "Chrome on
  /// Pixel" so a user can tell which device to revoke.
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// =====================================================================
// AlbumPhoto — photos uploaded DIRECTLY to the shared photo wall, not
// derived from a post/comment/page. Lets people add to the family album
// freely without writing a post. The wall query unions these with the
// derived photos. Caption optional; uploader owns it (can remove).
// =====================================================================
model AlbumPhoto {
  id        String   @id @default(cuid())
  uploaderId String
  uploader  User     @relation("AlbumPhotoUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  /// Full-size image URL (under /uploads).
  url       String
  /// Optional 800px thumbnail URL; falls back to `url`.
  thumbUrl  String?
  caption   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([uploaderId])
}

// =====================================================================
// Analytics (firewall — never JOINs into core)
// =====================================================================

// =====================================================================
// PasswordReset — one-shot tokens for the "forgot password" flow.
// We store the SHA-256 of the token, not the token itself, so a DB
// leak can't be used to forge a reset link (same threat model as
// Session). Default TTL is 1 hour. `usedAt` is set when the token is
// consumed so the same link can't reset twice.
// =====================================================================
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The email this token was issued to. Pinned at issue time so that
  /// if the user later changes their address, an old token that leaked
  /// to the previous mailbox (or was forwarded by mistake) can't be
  /// redeemed. Verified to match `User.email` at consumption.
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// =====================================================================
// EmailVerification — same shape as PasswordReset but for the "prove
// you own this email" flow. Issued whenever a user sets a new email
// (at setup, or when they change it in account settings). 24h TTL —
// longer than password reset because it's convenience, not a security
// race. Email is pinned at issue so a forwarded link can't verify a
// later address change.
// =====================================================================
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// =====================================================================
// Feedback — messages from any member to the admins. In-app "聯絡管理員 /
// 意見回饋" inbox. Not a DM system (no threading, no replies); admins read
// and mark resolved. Anyone signed in can submit; only admins can read the
// list (gated in the queries + page).
// =====================================================================
model Feedback {
  id          String   @id @default(cuid())
  /// Author. Optional FK so deleting a user doesn't erase their feedback
  /// history — we keep the message, just null the author (SetNull).
  authorId    String?
  author      User?    @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Coarse bucket so admins can triage: BUG | IDEA | QUESTION | OTHER.
  /// Free-text column (no enum) for migration-flexibility.
  kind        String   @default("OTHER")
  /// One-line subject (optional) + the body.
  subject     String?
  body        String
  /// Optional contact override — if the member wants a reply somewhere
  /// other than their account email. Free text.
  contact     String?
  /// Lifecycle: OPEN → RESOLVED. Admins flip it; authors only ever create.
  status      String   @default("OPEN") // OPEN | RESOLVED
  resolvedById String?
  resolvedBy   User?   @relation("FeedbackHandler", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([authorId])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  kind        String // vote.cast, activity.rsvp, post.viewed, ...
  userId      String?
  subjectType String
  subjectId   String
  properties  String // JSON-encoded
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@index([subjectType, subjectId])
}

// =====================================================================
// Lodging — recommendations & past-stay history, keyed by region so we
// can surface relevant accommodation when planning a new activity in
// the same area. Owned at the community level (anyone can add), with
// optional link to the activity that stayed there.
// =====================================================================

model Lodging {
  id          String    @id @default(cuid())
  name        String
  /// Region/area key used for recommendations. Free text — matching is
  /// substring-insensitive against `Activity.location`. Examples:
  /// "宜蘭礁溪", "Kyoto", "墾丁".
  region      String
  address     String?
  notes       String?
  /// Per-night rate in 1/100 of currency unit (cents). Optional.
  pricePerNightCents Int?
  currency    String   @default("TWD")
  url         String?
  /// 1-5 community rating. Optional.
  rating      Int?
  addedById   String
  addedBy     User     @relation("LodgingAddedBy", fields: [addedById], references: [id], onDelete: Cascade)
  /// When true, ANY signed-in member can edit this lodging entry (not
  /// just the person who added it / admins). Delete stays owner-or-admin.
  /// Opt-in by the creator. Default false = original behaviour.
  allowCollab Boolean  @default(false)
  /// When this lodging was used during a real trip. Null = recommendation only.
  stayedAt    DateTime?
  activityId  String?
  activity    Activity? @relation("LodgingActivity", fields: [activityId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([region])
  @@index([addedById])
}
